{
  "manifest_version": 2,
  "id": "local.novelai-image",
  "name": "NovelAI 文生图",
  "version": "1.4.0",
  "description": "NovelAI 自动参数绘图、角色与画风参考、NanoGPT 中文标签翻译",
  "author": {
    "name": "Local",
    "url": "https://docs.novelai.net/en/image/"
  },
  "urls": {
    "homepage": "https://docs.novelai.net/en/image/",
    "repository": "https://github.com/Mai-with-u/maibot-plugin-sdk"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27,<1"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10,<13"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "send.forward",
    "config.get",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
